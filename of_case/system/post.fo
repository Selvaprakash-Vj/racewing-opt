/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM functionObject dictionary (for postProcess -func wingSurf)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      wingSurf;
}

type            surfaces;
libs            ("libsampling.so");
writeControl    timeStep;
writeInterval   1;

interpolationScheme cellPoint;

surfaces
(
    wing
    {
        type            patch;
        patches         (wing);      // <-- use the new patch name
        fields          (p);
        surfaceFormat   vtp;         // write .vtp
        triangulate     true;
        interpolate     true;
    }
);
