#!/usr/bin/env python3
import argparse, subprocess, os, sys, csv, datetime, re, glob
from pathlib import Path
from typing import Optional, Tuple

ROOT = Path(__file__).resolve().parent.parent
CASE = ROOT / "of_case"
POST = CASE / "postProcessing"

# Make scripts/ importable (for postproc_fea)
sys.path.insert(0, str((ROOT / "scripts").resolve()))
from postproc_fea import extract_results  # now module-level, no indent issues

def run(cmd, **kw):
    print("[RUN]", " ".join(map(str, cmd)))
    return subprocess.run(cmd, check=True, **kw)

def parse_force_coeffs() -> Tuple[Optional[float], Optional[float], str]:
    """
    Prefer coefficient.dat under postProcessing; fallback to simpleFoam.log.
    Returns (Cd, Cl, note).
    """
    note = ""
    patterns = [
        str(POST / "forceCoeffs" / "*" / "coefficient.dat"),
        str(POST / "forceCoeffs" / "*" / "forceCoeffs.dat"),
        str(POST / "forceCoeffs" / "coefficient.dat"),
        str(POST / "forces"      / "*" / "coefficient.dat"),
    ]
    files = []
    for pat in patterns:
        files.extend(glob.glob(pat))

    Cd = Cl = None
    if files:
        f = sorted(files, key=os.path.getmtime)[-1]
        try:
            # read the last ~200 lines and find the last numeric row with >=10 floats
            with open(f, "rb") as fp:
                tail = fp.readlines()[-200:]
            lastnums = None
            for raw in reversed(tail):
                parts = raw.decode("utf-8","ignore").strip().split()
                nums = []
                for s in parts:
                    try: nums.append(float(s))
                    except: nums = []; break
                if len(nums) >= 10:
                    lastnums = nums
                    break
            if lastnums:
                Cd, Cl = lastnums[7], lastnums[8]
                note = f"from {Path(f).name}"
        except Exception as e:
            note = f"coeff parse err: {e}"

    if Cd is None or Cl is None:
        # fallback: parse simpleFoam.log for 'Cd:' and 'Cl:'
        logp = CASE / "logs" / "simpleFoam.log"
        if logp.exists():
            try:
                pat = re.compile(r'\bC([ld])\s*[:=]\s*([-+0-9.eE]+)')
                vals = {}
                for line in logp.read_text(errors="ignore").splitlines():
                    for m in pat.finditer(line):
                        vals[m.group(1)] = float(m.group(2))
                Cd = Cd if Cd is not None else vals.get('d')
                Cl = Cl if Cl is not None else vals.get('l')
                if Cd is not None and Cl is not None and not note:
                    note = "from simpleFoam.log"
            except Exception as e:
                note = f"log parse err: {e}"
    return Cd, Cl, note

def ensure_wing_vtp_symlink():
    """
    post.fo writes to postProcessing/surfaces/<time>/wingSurf.vtp.
    FEA expects postProcessing/wingSurf/<time>/wingPatch.vtp.
    Create that mirror symlink if needed and return the chosen <time>.
    """
    surfaces = POST / "surfaces"
    if not surfaces.exists():
        return None
    times = []
    for p in surfaces.iterdir():
        if p.is_dir():
            try:
                times.append((float(p.name), p))
            except:
                pass
    if not times:
        return None
    lt = sorted(times)[-1][1].name
    dst_dir = POST / "wingSurf" / lt
    dst_dir.mkdir(parents=True, exist_ok=True)
    src = POST / "surfaces" / lt / "wingSurf.vtp"
    dst = dst_dir / "wingPatch.vtp"
    if src.exists() and not dst.exists():
        try:
            rel = os.path.relpath(src, dst_dir)
            os.symlink(rel, dst)
        except OSError:
            import shutil; shutil.copy2(src, dst)
    return lt

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--aoa_deg", type=float, required=True)
    ap.add_argument("--thickness", type=float, required=True)
    args = ap.parse_args()

    print("=== EVALUATE: geometry → CFD → pressure → FEA ===")
    print(f"AOA={args.aoa_deg:.1f} deg | thickness={args.thickness:.4g} m\n")

    # 1) Geometry
    run(["python3","scripts/generate_geometry.py",
         "--aoa_deg", f"{args.aoa_deg:.1f}",
         "--out", str(CASE/"constant/triSurface/wing.stl")])

    # 2) CFD
    run(["bash","scripts/run_cfd.sh", str(CASE)])

    # 2b) Cd/Cl
    Cd, Cl, note_coeff = parse_force_coeffs()
    if Cd is None or Cl is None:
        Cd = Cd or 0.0
        Cl = Cl or 0.0

    # 3) postProcess surface mapping symlink
    lt = ensure_wing_vtp_symlink()
    vtp = str(POST / "wingSurf" / (lt or "0") / "wingPatch.vtp")
    print(f"[ok] using VTP: {vtp}")

    # 4) FEA
    ts_tag = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    outbase = Path("fea")/f"auto_run_{ts_tag}"
    outbase_abs = (ROOT / outbase).resolve()
    run([
        "python3","scripts/map_and_run_fea.py",
        "--surface-vtk", vtp,
        "--outbase", str(outbase_abs),
        "--thickness", f"{args.thickness:.9g}"
    ])

    # 5) Extract FEA results from <outbase>.dat with .frd fallback inside extract_results
    dat_path = Path(str(outbase_abs) + ".dat")
    max_disp, max_stress = extract_results(str(dat_path))

    # 6) Append results
    results_dir = ROOT / "results"
    results_dir.mkdir(exist_ok=True)
    header = ["timestamp","aoa_deg","thickness_m","Cd","Cl","max_disp_m","max_stress_Pa","fea_outbase","notes"]
    row = [
        datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        args.aoa_deg, args.thickness,
        Cd, Cl,
        max_disp if max_disp is not None else "",
        max_stress if max_stress is not None else "",
        str(outbase_abs),
        note_coeff + ("" if (max_disp is not None and max_stress is not None) else " [warn] FEA results missing")
    ]

    def append_csv(path: Path, row):
        new = not path.exists()
        with open(path, "a", newline="") as f:
            w = csv.writer(f, delimiter=',')
            if new: w.writerow(header)
            w.writerow(row)

    if (Cd == 0.0 and Cl == 0.0) or (max_disp is None) or (max_stress is None):
        append_csv(results_dir/"summary_pending.csv", row)
        print("\n=== DONE with warnings ===")
        missing = []
        if Cd == 0.0 and Cl == 0.0: missing += ["Cd/Cl"]
        if max_disp is None:        missing += ["max_disp"]
        if max_stress is None:      missing += ["max_stress"]
        print(f"[warn] Missing values → wrote to {results_dir/'summary_pending.csv'}")
        print("[info] Missing:", " ".join(missing))
    else:
        append_csv(results_dir/"summary.csv", row)
        print("\n=== DONE ===")
        print(f"[ok] Appended results → {results_dir/'summary.csv'}")
        print(f"[info] outbase: {outbase_abs}")

if __name__ == "__main__":
    main()

# ==== override Cd/Cl parser with a header-driven version ====
def parse_force_coeffs():
    """
    Read Cd/Cl from postProcessing/forceCoeffs/**/coefficient.dat using header names.
    Fallback to simpleFoam.log if needed. Returns (Cd, Cl, note).
    """
    import glob, os, re
    from pathlib import Path

    note = ""
    patterns = [
        str(POST / "forceCoeffs" / "*" / "coefficient.dat"),
        str(POST / "forceCoeffs" / "*" / "forceCoeffs.dat"),
        str(POST / "forceCoeffs" / "coefficient.dat"),
        str(POST / "forces"      / "*" / "coefficient.dat"),
    ]
    files = []
    for pat in patterns:
        files.extend(glob.glob(pat))

    def try_file(fpath: str):
        header_cols = None
        last_nums = None
        with open(fpath, "r", errors="ignore") as fp:
            for line in fp:
                line = line.strip()
                if not line:
                    continue
                if line.startswith("#"):
                    # capture the most recent header line
                    cols = re.sub(r"^#+", "", line).strip()
                    cols = re.sub(r"[(),]", " ", cols)
                    cols = cols.split()
                    if len(cols) >= 2:
                        header_cols = cols
                    continue
                # numeric line?
                parts = line.split()
                nums = []
                ok = True
                for s in parts:
                    try:
                        nums.append(float(s))
                    except Exception:
                        ok = False
                        break
                if ok and len(nums) >= 3:
                    last_nums = nums  # keep last numeric row
        if last_nums is None:
            return None, None

        Cd = Cl = None
        if header_cols:
            idx = {name: i for i, name in enumerate(header_cols)}
            # common name variants
            cd_keys = [k for k in ("Cd","C_D","cD","CD") if k in idx]
            cl_keys = [k for k in ("Cl","C_L","cL","CL") if k in idx]
            if cd_keys and cl_keys:
                Cd = last_nums[idx[cd_keys[0]]]
                Cl = last_nums[idx[cl_keys[0]]]
            # Many files are: Time Cd Cl ...
            if (Cd is None or Cl is None) and header_cols[0].lower().startswith("time") and len(last_nums) >= 3:
                Cd = last_nums[1]
                Cl = last_nums[2]

        # Heuristic fallback if header names didn’t match
        if (Cd is None or Cl is None):
            L = len(last_nums)
            if L >= 3:
                Cd = last_nums[1]
                Cl = last_nums[2]
            if L >= 10:
                # layout: Time Fx Fy Fz Mx My Mz Cd Cl Cz ...
                Cd = last_nums[7]
                Cl = last_nums[8]
        return Cd, Cl

    if files:
        f = sorted(files, key=os.path.getmtime)[-1]
        try:
            Cd, Cl = try_file(f)
            if Cd is not None and Cl is not None:
                return Cd, Cl, f"from {Path(f).name}"
        except Exception:
            pass

    # fallback: simpleFoam.log (it prints "Cd: 0.0383", etc.)
    logp = CASE / "logs" / "simpleFoam.log"
    if logp.exists():
        try:
            pat = re.compile(r'\bC([ld])\s*[:=]\s*([-+0-9.eE]+)')
            vals = {}
            for line in logp.read_text(errors="ignore").splitlines():
                for m in pat.finditer(line):
                    vals[m.group(1)] = float(m.group(2))
            Cd = vals.get('d')
            Cl = vals.get('l')
            if Cd is not None and Cl is not None:
                return Cd, Cl, "from simpleFoam.log"
        except Exception:
            pass

    return 0.0, 0.0, "coefficients not found"

# ==== final override: read Cd/Cl from simpleFoam.log (robust) ====
def parse_force_coeffs():
    """
    Parse Cd/Cl from of_case/logs/simpleFoam.log by reading the last
    'forceCoeffs write:' block. Ignore malformed coefficient.dat files.
    """
    import re
    logp = CASE / "logs" / "simpleFoam.log"
    Cd = Cl = None
    note = "from simpleFoam.log"
    if logp.exists():
        block_started = False
        last_vals = {}
        # patterns like: 'Cd:  0.0383373'
        pat = re.compile(r'^\s*(C[dlsS][^:]*)\s*:\s*([-+0-9.eE]+)')
        with open(logp, "r", errors="ignore") as fp:
            for line in fp:
                if "forceCoeffs" in line and "write" in line:
                    # start a new block
                    block_started = True
                    last_vals = {}
                    continue
                if block_started:
                    m = pat.match(line)
                    if m:
                        key = m.group(1).strip()
                        val = float(m.group(2))
                        last_vals[key] = val
        # prefer explicit keys
        if "Cd" in last_vals and "Cl" in last_vals:
            Cd, Cl = last_vals["Cd"], last_vals["Cl"]
        elif "Cd(f)" in last_vals and "Cd(r)" in last_vals:
            # total as sum of front+rear (rarely needed)
            Cd = last_vals["Cd(f)"] + last_vals["Cd(r)"]
            Cl = (last_vals.get("Cl(f)", 0.0) + last_vals.get("Cl(r)", 0.0))
        # fallthrough if not found: return zeros with note
    return Cd or 0.0, Cl or 0.0, note
