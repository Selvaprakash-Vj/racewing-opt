#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Map OpenFOAM surface pressure (VTP/VTK) -> CalculiX shell input,
run ccx, and archive results.

Deps: numpy, meshio (pip install --break-system-packages meshio)
"""
import argparse, os, sys, tarfile, time
import numpy as np

# ---------- IO helpers ----------
def read_surface_meshio(path):
    import meshio
    m = None
    try:
        # meshio auto-detect usually works on .vtp
        m = meshio.read(path)
    except Exception:
        # some meshio builds need the explicit format for VTP
        m = meshio.read(path, file_format="xml")  # generic XML reader
    if m.points is None or len(m.points) == 0:
        raise ValueError("No points found in surface file")

    # Find triangle cells
    tri = None
    tri_block_index = None
    for i, cb in enumerate(m.cells):
        if cb.type in ("triangle",):
            tri = np.asarray(cb.data, dtype=int)
            tri_block_index = i
            break
        if cb.type in ("polygon", "polygons"):
            # keep only 3-vertex polys (should already be triangles)
            data = np.asarray(cb.data, dtype=int)
            # When polygons have ragged rows, meshio flattens with offsets; typical VTP from OpenFOAM
            # comes as triangles, but be defensive:
            # If shape is (N,3) it's fine; otherwise we cannot easily reshape without offsets.
            if data.ndim == 2 and data.shape[1] == 3:
                tri = data
                tri_block_index = i
                break
    if tri is None or len(tri) == 0:
        raise ValueError("No triangular faces found in surface file (need triangles).")

    P = np.asarray(m.points, dtype=float)

    # Prefer cell pressure
    p_elem = None
    # Newer meshio stores cell data per block, e.g. m.cell_data_dict or m.cell_data["p"][i]
    # Try several access patterns:
    if hasattr(m, "cell_data") and m.cell_data:
        # Try dict-style first
        try:
            # Preferred: dict-of-lists keyed by name
            cd = m.cell_data
            if isinstance(cd, dict) and "p" in cd:
                arrs = cd["p"]
                # pick the array that matches our triangle block
                if tri_block_index is not None and tri_block_index < len(arrs):
                    cand = np.asarray(arrs[tri_block_index]).ravel()
                    if cand.size == len(tri):
                        p_elem = cand.astype(float)
                # fallback: first array with matching length
                if p_elem is None:
                    for a in arrs:
                        a = np.asarray(a).ravel()
                        if a.size == len(tri):
                            p_elem = a.astype(float); break
        except Exception:
            pass

        # Older access pattern: iterate names in cell_data dict entries
        if p_elem is None:
            try:
                # m.cell_data is dict-like of lists keyed by name in new versions, but
                # in some builds it's a list of dicts. Try to scan everything.
                for name, arrays in m.cell_data.items():
                    if name == "p":
                        for a in arrays:
                            a = np.asarray(a).ravel()
                            if a.size == len(tri):
                                p_elem = a.astype(float); break
                    if p_elem is not None:
                        break
            except Exception:
                pass

    # If no cell pressure, try point pressure and average to faces
    if p_elem is None:
        p_pt = None
        if hasattr(m, "point_data") and m.point_data:
            # try "p" first
            for key in ("p", "pressure", "P"):
                if key in m.point_data:
                    p_pt = np.asarray(m.point_data[key], dtype=float).ravel()
                    break
        if p_pt is None:
            raise ValueError("Pressure field 'p' not found as cell or point data on the surface.")
        if p_pt.size != P.shape[0]:
            raise ValueError(f"Point pressure size mismatch: got {p_pt.size}, points {P.shape[0]}")
        p_elem = p_pt[tri].mean(axis=1)

    return P, tri, p_elem

def uniquify_vertices(verts, faces, tol=1e-12):
    """Deduplicate vertices (tri mesh). Returns unique verts and remapped faces."""
    key = np.round(verts / tol) * tol
    uniq, idx = np.unique(key, axis=0, return_inverse=True)
    F2 = idx[faces]
    return uniq, F2

# ---------- CCX writer ----------
def write_ccx_inp(outbase, V, F, p_elem, t_shell=2.0e-3, E=70e9, nu=0.3, rho=1600.0):
    fn = outbase + ".inp"
    N = V.shape[0]
    with open(fn, "w") as f:
        f.write("*HEADING\nWing shell from CFD pressure\n")

        # Nodes
        f.write("*NODE\n")
        for i,(x,y,z) in enumerate(V, start=1):
            f.write(f"{i},{x:.9g},{y:.9g},{z:.9g}\n")

        # Elements (tri shells)
        f.write("*ELEMENT, TYPE=S3, ELSET=ALL_SHELL\n")
        for i,(a,b,c) in enumerate(F, start=1):
            f.write(f"{i},{a+1},{b+1},{c+1}\n")

        # Define a global ALL node set (for output etc.)
        f.write(f"*NSET, NSET=ALL, GENERATE\n1,{N},1\n")

        # Material (isotropic placeholder)
        f.write("*MATERIAL, NAME=CFRP\n")
        f.write("*ELASTIC\n{:.9g},{:.9g}\n".format(E,nu))
        f.write("*DENSITY\n{:.9g}\n".format(rho))

        # Shell section
        f.write("*SHELL SECTION, ELSET=ALL_SHELL, MATERIAL=CFRP\n{:.9g}\n".format(t_shell))

        # Root clamp: nodes with x <= minX + 1% chord
        minx, maxx = V[:,0].min(), V[:,0].max()
        chord = maxx - minx
        clamp_limit = minx + 0.01*chord
        root_nodes = np.where(V[:,0] <= clamp_limit)[0] + 1
        if root_nodes.size == 0:
            # fallback: clamp 1% of the lowest-x nodes
            k = max(1, int(0.01*N))
            root_nodes = np.argsort(V[:,0])[:k] + 1

        f.write("*NSET, NSET=MOUNT\n")
        for i in range(0, root_nodes.size, 16):
            f.write(",".join(map(str, root_nodes[i:i+16])) + "\n")

        # Boundary: fix all 6 dofs at MOUNT
        f.write("*BOUNDARY\nMOUNT, 1, 6\n")

        # Apply pressure as DLOAD (positive value pushes in shell normal; use -p to push "out")
        f.write("*STEP\n*STATIC\n")
        f.write("*DLOAD\n")
        for eid, p in enumerate(p_elem, start=1):
            f.write(f"{eid},P,{ -float(p):.9g}\n")

        # Outputs
        f.write("*NODE PRINT, NSET=ALL\nU\n")
        f.write("*EL PRINT, ELSET=ALL_SHELL\nS\n")
        f.write("*END STEP\n")
    return fn

def run_ccx(outbase):
    import subprocess
    try:
        subprocess.run(["ccx", os.path.basename(outbase)], cwd=os.path.dirname(outbase) or ".", check=True)
        return True
    except FileNotFoundError:
        print("[warn] ccx not found. Install 'calculix-ccx'.", file=sys.stderr)
        return False
    except subprocess.CalledProcessError as e:
        print("[err] CalculiX failed:", e, file=sys.stderr)
        return False

def archive_results(outbase, dest_dir="backups"):
    os.makedirs(dest_dir, exist_ok=True)
    ts = time.strftime("%Y%m%d_%H%M%S")
    base = os.path.basename(outbase)
    tarname = os.path.join(dest_dir, f"fea_run_{base}_{ts}.tar.gz")
    exts = (".dat",".frd",".sta",".cvg",".12d",".inp")
    to_add = [outbase+e for e in exts if os.path.exists(outbase+e)]
    if not to_add:
        return None
    with tarfile.open(tarname, "w:gz") as tar:
        for p in to_add:
            tar.add(p, arcname=os.path.basename(p))
    return tarname

# ---------- main ----------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--surface-vtk", required=True, help="Path to wing surface VTP/VTK with pressure p")
    ap.add_argument("--outbase", default="fea/run1", help="Output base path without extension")
    ap.add_argument("--thickness", type=float, default=2.0e-3, help="Shell thickness (m)")
    ap.add_argument("--youngs", type=float, default=70e9, help="Young's modulus (Pa)")
    ap.add_argument("--nu", type=float, default=0.3, help="Poisson ratio")
    ap.add_argument("--rho", type=float, default=1600.0, help="Density (kg/m3)")
    args = ap.parse_args()

    # Read surface + pressure
    P,F,p_elem = read_surface_meshio(args.surface_vtk)
    if P.shape[0] == 0 or F.shape[0] == 0:
        print("Empty surface", file=sys.stderr); sys.exit(2)

    # Deduplicate vertices
    V,F2 = uniquify_vertices(P, F)

    # Ensure out dir exists
    outdir = os.path.dirname(args.outbase)
    if outdir and not os.path.isdir(outdir):
        os.makedirs(outdir, exist_ok=True)

    # Write CCX input
    inp = write_ccx_inp(args.outbase, V, F2, p_elem,
                        t_shell=args.thickness, E=args.youngs, nu=args.nu, rho=args.rho)

    # Run ccx
    ok = run_ccx(args.outbase)
    if ok:
        print(f"[ok] CalculiX done. See {args.outbase}.dat / .frd")
    else:
        print(f"[warn] CalculiX did not finish cleanly. Check {args.outbase}.dat", file=sys.stderr)

    # Archive
    tar = archive_results(args.outbase, dest_dir="backups")
    if tar:
        print(f"[ok] Archived FEA outputs → {tar}")

if __name__ == "__main__":
    main()
